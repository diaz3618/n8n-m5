#!/usr/bin/env bash
# Enable with: git config core.hooksPath .githooks
set -e
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

if echo "$staged" | grep -qE '(^|/)\.env($|\.)|\.mcp\.json$'; then
  echo "pre-commit: refusing to commit an env or MCP config file" >&2
  exit 1
fi
if git diff --cached -U0 | grep -E '^\+' | grep -qE 'eyJ[A-Za-z0-9_-]{15,}\.[A-Za-z0-9_-]{15,}\.|X-N8N-API-KEY:\s*[A-Za-z0-9]{20,}'; then
  echo "pre-commit: staged changes look like they contain a JWT or API key" >&2
  exit 1
fi
if command -v gitleaks >/dev/null; then
  gitleaks protect --staged --no-banner
fi
